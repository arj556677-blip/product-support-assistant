# ===== TEXT / VISION / IMAGE GENERATION =====
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY

# Deployment names
TEXT_MODEL_DEPLOYMENT=gpt-4.1-mini
VISION_MODEL_DEPLOYMENT=gpt-4.1-mini

# ===== SPEECH =====
SPEECH_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com/
SPEECH_API_KEY=YOUR_SPEECH_API_KEY
SPEECH_REGION=eastus

# ===== CONTENT UNDERSTANDING =====
CONTENT_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com/
CONTENT_API_KEY=YOUR_CONTENT_API_KEY
CONTENT_API_VERSION=2025-11-01

# ===== FOUNDRY PROJECT =====
FOUNDRY_PROJECT_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com/api/projects/YOUR_PROJECT
FOUNDRY_API_KEY=YOUR_FOUNDRY_API_KEY
